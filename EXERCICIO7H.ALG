Algoritmo "Exercicio7h"

Var
   C: real
   L: real
   A: real
   V: real

Inicio

   escreva("Digite o comprimento: ")
   leia(C)

   escreva("Digite a largura: ")
   leia(L)

   escreva("Digite a altura: ")
   leia(A)

   V <- C * L * A

   escreval("Volume da caixa: ", V)

Fimalgoritmo