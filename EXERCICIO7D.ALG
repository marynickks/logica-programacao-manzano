Algoritmo "Exercicio7d"

Var
   T, V, D, L: real

Inicio

   escreva("Digite o tempo: ")
   leia(T)

   escreva("Digite a velocidade: ")
   leia(V)

   D <- T * V
   L <- D / 12

   escreval("Velocidade: ", V)
   escreval("Tempo: ", T)
   escreval("Distancia: ", D)
   escreval("Litros: ", L)

Fimalgoritmo