Algoritmo "L03E"

Var
   Expoente: inteiro
   Resultado: real

Inicio

   Expoente <- 0
   Resultado <- 1

   enquanto Expoente <= 15 faca

      escreval("3 elevado a ", Expoente, " = ", Resultado)

      Resultado <- Resultado * 3
      Expoente <- Expoente + 1

   fimenquanto

Fimalgoritmo