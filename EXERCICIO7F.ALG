Algoritmo "Exercicio7g"

Var
   A: inteiro
   B: inteiro
   C: inteiro
   D: inteiro

Inicio

   escreva("Digite A: ")
   leia(A)

   escreva("Digite B: ")
   leia(B)

   escreva("Digite C: ")
   leia(C)

   escreva("Digite D: ")
   leia(D)

   escreval("A + B = ", A + B)
   escreval("A * B = ", A * B)

   escreval("A + C = ", A + C)
   escreval("A * C = ", A * C)

   escreval("A + D = ", A + D)
   escreval("A * D = ", A * D)

   escreval("B + C = ", B + C)
   escreval("B * C = ", B * C)

   escreval("B + D = ", B + D)
   escreval("B * D = ", B * D)

   escreval("C + D = ", C + D)
   escreval("C * D = ", C * D)

Fimalgoritmo